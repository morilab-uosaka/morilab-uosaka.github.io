---
layout: page
---
<div class="post">
  <article>
    <hr />

    <h2>staff</h2>
    {% if page.profiles %}
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3">
        {% for profile in page.profiles %}
          <div class="col mb-4">
            <div class="card h-100">
              {% if profile.image %}
                {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
                {% if profile.image_circular %}
                  {% assign profile_image_class = 'card-img-top img-fluid z-depth-1 rounded-circle mx-auto mt-3' %}
                {% else %}
                  {% assign profile_image_class = 'card-img-top img-fluid z-depth-1 rounded mx-auto mt-3' %}
                {% endif %}
                {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.05}}px, (min-width: 992px) 25vw, (min-width: 768px) 20vw, 20vw"{% endcapture %}
                {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile.image style="max-width:80%; height:auto;" %}
              {% endif %}
              
              <div class="card-body text-center">
                {% if profile.more_info %}
                  <div class="more-info">{{ profile.more_info }}</div>
                {% endif %}
                <div class="social-icons">
                  {% if profile.email %}
                    <a href="mailto:{{ profile.email | encode_email }}" target="_blank" title="email"><i class="fa-solid fa-envelope"></i></a>
                  {% endif %}
                  {% if profile.url %}
                    <a href="{{ profile.url }}" target="_blank" title="Work"><i class="fa-solid fa-square-up-right"></i></a>
                  {% endif %}
                  {% if profile.orcid %}
                    <a href="https://orcid.org/{{ profile.orcid }}" target="_blank" title="ORCID"><i class="ai ai-orcid fa-lg"></i></a>
                  {% endif %}
                  {% if profile.googlescholar %}
                    <a href="{{ profile.googlescholar }}" target="_blank" title="Google Scholar"><i class="ai ai-google-scholar fa-lg"></i></a>
                  {% endif %}
                  {% if profile.researchgate %}
                    <a href="{{ profile.researchgate }}" target="_blank" title="ResearchGate"><i class="fab fa-researchgate fa-lg"></i></a>
                  {% endif %}
                  {% if profile.bluesky %}
                    <a href="{{ profile.bluesky }}" target="_blank" title="Bluesky"><i class="fa-brands fa-bluesky"></i></a>
                  {% endif %}
                  {% if profile.twitter %}
                    <a href="https://x.com/{{ profile.twitter }}" target="_blank" title="X"><i class="fa-brands fa-x-twitter"></i></a>
                  {% endif %}
                  {% if profile.github %}
                    <a href="https://github.com/{{ profile.github }}" target="_blank" title="GitHub"><i class="fa-brands fa-github"></i></a>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
    <hr />

    <h2>student</h2>
    <br>
    <p> <b> D2 </b>&ensp;松本 紗耶未 (Sayami MATSUMOTO)</p>
    <p> <b> D2 </b>&ensp;秦 子皓 (Zihao QIN)</p>
    <p> <b> M2 </b>&ensp;中根 晴太 (Hareta NAKANE)</p>
    <p> <b> M2 </b>&ensp;北浦 太一 (Taichi KITAURA)</p>
    <p> <b> M2 </b>&ensp;小阪 龍世 (Ryusei KOSAKA)</p>
    <p> <b> M1 </b>&ensp;茨木 諒介 (Ryosuke IBARAGI)</p>
    <p> <b> M1 </b>&ensp;中津 皐稀 (Koki NAKATSU)</p>
    <p> <b> M1 </b>&ensp;林 慶次郎 (Keijiro HAYASHI)</p>
    <p> <b> B4 </b>&ensp;宇野 芽依 (Mei UNO)</p>
    <p> <b> B4 </b>&ensp;國立 昂希 (Koki KUNITATE)</p>
    <p> <b> B4 </b>&ensp;岸本 信人 (Nobuhito KISHIMOTO)</p>

    <hr />
    <h2>alumni</h2>
    <br>
    <b>AY2025</b>
    <p> &ensp;久次米　智裕 (Tomohiro KUJIME, 修士)</p>
    <p> &ensp;渡部　壮一郎 (Soichiro WATANABE, 修士)</p>
    <p> &ensp;NYAMDASH Bolortuya (修士)</p>
    <p> &ensp;松浦　実乃里 (Minori MATSUURA, 修士)</p>
    <p> &ensp;二宮　幸大 (Kota NINOMIYA, 学士)</p>

  </article>
</div>

<style>
  .social-icons {
    margin-top: 10px;
  }
  .social-icons a {
    margin: 0 5px;
    color: var(--global-text-color);
    transition: color 0.3s ease;
  }
  .social-icons a:hover {
    color: var(--global-theme-color);
  }
</style>
