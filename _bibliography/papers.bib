@article{wakako2023pressure,
  bibtex_show={true},
  title={Pressure-responsive polymer chemosensors for hydrostatic-pressure-signal detection: poly-L-lysine--pyrene conjugates},
  author={Wakako, Soshi and Hori, Yumiko and Kinoshita, Tomokazu and Saiki, Takao and Qi, Xinyi and Hasegawa, Koki and Imai, Yoshitane and Mori, Tadashi and Nakagawa, Keiichi and Fukuhara*, Gaku},
